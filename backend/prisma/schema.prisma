generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  STAFF
  TECHNICIAN
  SUPERVISOR
}

enum WorkOrderStatus {
  OPEN
  IN_PROGRESS
  SUBMITTED
  NEEDS_REVISION
  APPROVED
  CANCELLED
}

enum WorkOrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum EvidenceCategory {
  BEFORE
  AFTER
  OTHER
}

enum WorkOrderEventType {
  CREATED
  ASSIGNED
  STARTED
  CHECKLIST_UPDATED
  EVIDENCE_ADDED
  EVIDENCE_REMOVED
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  CANCELLED
  MATERIAL_ISSUED
}

enum TxType {
  RECEIVE
  ISSUE
  ADJUST
}

enum TxStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model User {
  id           String             @id @default(uuid())
  email        String             @unique
  passwordHash String
  name         String
  role         Role               @default(STAFF)
  createdAt    DateTime           @default(now())
  createdTx    StockTransaction[] @relation("CreatedBy")
  confirmedTx  StockTransaction[] @relation("ConfirmedBy")
  uploads      Attachment[]       @relation("UploadedBy")

  createdWorkOrders  WorkOrder[]              @relation("WorkOrderCreatedBy")
  assignedWorkOrders WorkOrder[]              @relation("WorkOrderAssignee")
  reviewWorkOrders   WorkOrder[]              @relation("WorkOrderReviewer")
  reviewedWorkOrders WorkOrder[]              @relation("WorkOrderReviewedBy")
  workOrderEvents    WorkOrderEvent[]
  evidenceUploads    WorkOrderEvidence[]
  checklistDone      WorkOrderChecklistItem[]
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]
}

model Product {
  id         String                 @id @default(uuid())
  sku        String                 @unique
  barcode    String?                @unique
  name       String
  unit       String                 @default("pcs")
  minStock   Int                    @default(0)
  onHand     Int                    @default(0)
  imageUrl   String?
  categoryId String
  category   Category               @relation(fields: [categoryId], references: [id])
  items      StockTransactionItem[]
  materials  WorkOrderMaterial[]
  createdAt  DateTime               @default(now())
}

model StockTransaction {
  id            String                 @id @default(uuid())
  clientUuid    String?                @unique
  type          TxType
  status        TxStatus               @default(DRAFT)
  referenceNo   String?
  note          String?
  createdById   String
  createdBy     User                   @relation("CreatedBy", fields: [createdById], references: [id])
  confirmedById String?
  confirmedBy   User?                  @relation("ConfirmedBy", fields: [confirmedById], references: [id])
  createdAt     DateTime               @default(now())
  confirmedAt   DateTime?
  items         StockTransactionItem[]
  attachments   Attachment[]
  /// Optional: materials issued (or returned) for a work order.
  workOrderId   String?
  workOrder     WorkOrder?             @relation(fields: [workOrderId], references: [id], onDelete: Restrict)

  @@index([workOrderId])
}

model StockTransactionItem {
  id            String           @id @default(uuid())
  transactionId String
  transaction   StockTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId     String
  product       Product          @relation(fields: [productId], references: [id])
  quantity      Int
}

model Attachment {
  id            String           @id @default(uuid())
  transactionId String
  transaction   StockTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  url           String
  /// Cloudinary public_id, needed to delete the image.
  publicId      String?          @unique
  uploadedById  String?
  uploadedBy    User?            @relation("UploadedBy", fields: [uploadedById], references: [id])
  createdAt     DateTime         @default(now())
}

/// Read-only checklist templates (seeded). Work orders copy their items.
model ChecklistTemplate {
  id          String                  @id @default(uuid())
  name        String                  @unique
  description String?
  items       ChecklistTemplateItem[]
  workOrders  WorkOrder[]
}

model ChecklistTemplateItem {
  id          String            @id @default(uuid())
  templateId  String
  template    ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title       String
  description String?
  required    Boolean           @default(true)
  position    Int

  @@unique([templateId, position])
}

model WorkOrder {
  id               String             @id @default(uuid())
  /// Human code WO-00001 is derived from this.
  number           Int                @unique @default(autoincrement())
  clientUuid       String?            @unique
  title            String
  description      String?
  siteName         String
  siteAddress      String?
  priority         WorkOrderPriority  @default(NORMAL)
  status           WorkOrderStatus    @default(OPEN)
  dueAt            DateTime?
  requiredEvidence EvidenceCategory[]

  templateId   String?
  template     ChecklistTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdById  String
  createdBy    User               @relation("WorkOrderCreatedBy", fields: [createdById], references: [id])
  assigneeId   String?
  assignee     User?              @relation("WorkOrderAssignee", fields: [assigneeId], references: [id])
  /// Optional specific reviewer; otherwise any SUPERVISOR or ADMIN.
  reviewerId   String?
  reviewer     User?              @relation("WorkOrderReviewer", fields: [reviewerId], references: [id])
  reviewedById String?
  reviewedBy   User?              @relation("WorkOrderReviewedBy", fields: [reviewedById], references: [id])

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  startedAt    DateTime?
  submittedAt  DateTime?
  reviewedAt   DateTime?
  /// Latest request-changes reason (full history is in events).
  reviewNote   String?
  cancelReason String?

  checklist         WorkOrderChecklistItem[]
  materials         WorkOrderMaterial[]
  evidence          WorkOrderEvidence[]
  events            WorkOrderEvent[]
  stockTransactions StockTransaction[]

  @@index([status])
  @@index([assigneeId, status])
}

/// Snapshot of the template item at creation, plus the technician's result.
model WorkOrderChecklistItem {
  id            String    @id @default(uuid())
  workOrderId   String
  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  required      Boolean   @default(true)
  position      Int
  done          Boolean   @default(false)
  note          String?
  completedById String?
  completedBy   User?     @relation(fields: [completedById], references: [id])
  completedAt   DateTime?

  @@unique([workOrderId, position])
}

model WorkOrderMaterial {
  id          String    @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  plannedQty  Int

  @@unique([workOrderId, productId])
}

model WorkOrderEvidence {
  id           String           @id @default(uuid())
  workOrderId  String
  workOrder    WorkOrder        @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  category     EvidenceCategory
  url          String
  publicId     String           @unique
  note         String?
  uploadedById String
  uploadedBy   User             @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime         @default(now())

  @@index([workOrderId])
}

/// Append-only audit trail, written only by the server.
model WorkOrderEvent {
  id          String             @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder          @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  actorId     String
  actor       User               @relation(fields: [actorId], references: [id])
  type        WorkOrderEventType
  fromStatus  WorkOrderStatus?
  toStatus    WorkOrderStatus?
  note        String?
  createdAt   DateTime           @default(now())

  @@index([workOrderId, createdAt])
}
