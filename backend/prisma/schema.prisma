generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum TxType {
  RECEIVE
  ISSUE
  ADJUST
}

enum TxStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model User {
  id           String             @id @default(uuid())
  email        String             @unique
  passwordHash String
  name         String
  role         Role               @default(STAFF)
  createdAt    DateTime           @default(now())
  createdTx    StockTransaction[] @relation("CreatedBy")
  confirmedTx  StockTransaction[] @relation("ConfirmedBy")
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]
}

model Product {
  id         String                 @id @default(uuid())
  sku        String                 @unique
  barcode    String?                @unique
  name       String
  unit       String                 @default("pcs")
  minStock   Int                    @default(0)
  onHand     Int                    @default(0)
  imageUrl   String?
  categoryId String
  category   Category               @relation(fields: [categoryId], references: [id])
  items      StockTransactionItem[]
  createdAt  DateTime               @default(now())
}

model StockTransaction {
  id            String                 @id @default(uuid())
  clientUuid    String?                @unique
  type          TxType
  status        TxStatus               @default(DRAFT)
  referenceNo   String?
  note          String?
  createdById   String
  createdBy     User                   @relation("CreatedBy", fields: [createdById], references: [id])
  confirmedById String?
  confirmedBy   User?                  @relation("ConfirmedBy", fields: [confirmedById], references: [id])
  createdAt     DateTime               @default(now())
  confirmedAt   DateTime?
  items         StockTransactionItem[]
  attachments   Attachment[]
}

model StockTransactionItem {
  id            String           @id @default(uuid())
  transactionId String
  transaction   StockTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId     String
  product       Product          @relation(fields: [productId], references: [id])
  quantity      Int
}

model Attachment {
  id            String           @id @default(uuid())
  transactionId String
  transaction   StockTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  url           String
  createdAt     DateTime         @default(now())
}
