# Neon Postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=30&max_idle_connection_lifetime=60"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

JWT_SECRET="change-me"
JWT_EXPIRES_IN="1d"

# Demo accounts created by `npx prisma db seed`
# admin@stockflow.dev / staff@stockflow.dev
SEED_ADMIN_PASSWORD="Admin1234!"
SEED_STAFF_PASSWORD="Staff1234!"
# tech@ / tech2@ / supervisor@stockflow.dev
SEED_TECH_PASSWORD="Tech1234!"
SEED_SUPERVISOR_PASSWORD="Super1234!"

# Cloudinary (evidence photos). Dashboard -> Settings -> API Keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Rate limits per client per minute (defaults shown)
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10
